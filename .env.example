# LLM 提供方：mock（离线演示，无需 Key）| deepseek | claude
LLM_PROVIDER=mock

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# 如使用中转网关，填写网关地址；留空则使用官方地址
ANTHROPIC_BASE_URL=

LLM_TIMEOUT_SECONDS=90
# 是否走操作系统代理。本机代理不可用或直连 DeepSeek 时保持 false
LLM_USE_SYSTEM_PROXY=false

# 存储
DB_PATH=data/app.db
CHECKPOINT_DB_PATH=data/checkpoints.db

# Agent 策略
MAX_REPLANS=2
MAX_PLAN_ATTEMPTS=3

# 服务
API_HOST=127.0.0.1
API_PORT=8000
